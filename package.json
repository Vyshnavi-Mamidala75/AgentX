{
  "name": "agentx",
  "version": "1.0.0",
  "description": "Personalized AI Interview Agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/server.js",
    "test:loaders": "tsx scripts/testLoaders.ts",
    "test:contract": "tsx scripts/testPhase2Contract.ts",
    "test:phase3": "tsx scripts/testPhase3Personalization.ts",
    "test:phase4": "tsx scripts/testPhase4Feedback.ts",
    "test:phase6": "tsx scripts/testPhase6EdgeCases.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
